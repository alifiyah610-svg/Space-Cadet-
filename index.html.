        if (typeof THREE !== 'undefined' && typeof THREE.OrbitControls === 'undefined') {
            THREE.OrbitControls = function(camera, domElement) {
                this.camera = camera;
                this.domElement = domElement;
                this.target = new THREE.Vector3(0, 0, 0);
                this.enableDamping = true;
                this.dampingFactor = 0.05;
                this.maxDistance = 600;
                this.minDistance = 2;
               
                let isDragging = false;
                let isRightDragging = false;
                let previousMousePosition = { x: 0, y: 0 };
                let spherical = new THREE.Spherical();
                spherical.setFromVector3(camera.position.clone().sub(this.target));

                const self = this;
                domElement.addEventListener('contextmenu', (e) => e.preventDefault());
                domElement.addEventListener('pointerdown', (e) => {
                    if (e.button === 0) isDragging = true;
                    if (e.button === 2) isRightDragging = true;
                    previousMousePosition = { x: e.clientX, y: e.clientY };
                });
                window.addEventListener('pointermove', (e) => {
                    if (!isDragging && !isRightDragging) return;
                    const deltaX = e.clientX - previousMousePosition.x;
                    const deltaY = e.clientY - previousMousePosition.y;
                    if (isDragging) {
                        spherical.theta -= deltaX * 0.005;
                        spherical.phi -= deltaY * 0.005;
                        spherical.phi = Math.max(0.01, Math.min(Math.PI - 0.01, spherical.phi));
                    } else if (isRightDragging) {
                        const panSpeed = spherical.radius * 0.001;
                        self.target.x -= deltaX * panSpeed;
                        self.target.y += deltaY * panSpeed;
                    }
                    previousMousePosition = { x: e.clientX, y: e.clientY };
                });
                window.addEventListener('pointerup', () => {
                    isDragging = false;
                    isRightDragging = false;
                });
                domElement.addEventListener('wheel', (e) => {
                    e.preventDefault();
                    spherical.radius += e.deltaY * 0.1;
                    spherical.radius = Math.max(self.minDistance, Math.min(self.maxDistance, spherical.radius));
                }, { passive: false });

                this.update = function() {
                    const offset = new THREE.Vector3().setFromSpherical(spherical);
                    self.camera.position.copy(self.target).add(offset);
                    self.camera.lookAt(self.target);
                };
            };
        }

