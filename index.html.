        function createPlanets() {
            Object.keys(CELESTIAL_DATA).forEach((key) => {
                if (key === 'Sun' || key === 'Moon' || key === 'Clementine' || key === 'LunarProspector' || key === 'GRAIL' || key === 'Explorer35' || key === 'Spirit' || key === 'Orbiter' || key === 'Surveyor' || key === 'Mariner9') return;
                const data = CELESTIAL_DATA[key];

                createOrbitRing(data.distance);

                const orbitPivot = new THREE.Object3D();
                scene.add(orbitPivot);

                const geometry = new THREE.SphereGeometry(data.radius, 32, 32);
                const texture = createProceduralTexture(
                    data.radius > 3 ? 'gas' : 'rocky',
                    data.color,
                    data.detailColor
                );
                const material = new THREE.MeshStandardMaterial({
                    map: texture,
                    roughness: 0.7,
                    metalness: 0.1
                });
                const planetMesh = new THREE.Mesh(geometry, material);
                planetMesh.position.x = data.distance;
                planetMesh.userData = {
                    name: data.name,
                    data: data,
                    pivot: orbitPivot,
                    angle: Math.random() * Math.PI * 2
                };

                if (data.tilt) {
                    planetMesh.rotation.z = data.tilt;
                }

                if (data.hasRings) {
                    const ringGeo = new THREE.RingGeometry(data.radius * 1.4, data.radius * 2.3, 64);
                    const ringMat = new THREE.MeshBasicMaterial({
                        color: 0xd4be94,
                        side: THREE.DoubleSide,
                        transparent: true,
                        opacity: 0.65
                    });
                    const ringMesh = new THREE.Mesh(ringGeo, ringMat);
                    ringMesh.rotation.x = Math.PI / 2.4;
                    planetMesh.add(ringMesh);
                }

                orbitPivot.add(planetMesh);
                celestialMeshes[key] = planetMesh;

                if (data.hasMoon) {
                    const moonData = CELESTIAL_DATA.Moon;
                    const moonGeo = new THREE.SphereGeometry(moonData.radius, 24, 24);
                    const moonMat = new THREE.MeshStandardMaterial({ color: 0xcccccc, roughness: 0.9 });
                    const moonMesh = new THREE.Mesh(moonGeo, moonMat);
                    moonMesh.position.set(6.0, 0, 0);

                    const moonPivot = new THREE.Object3D();
                    planetMesh.add(moonPivot);
                    moonPivot.add(moonMesh);
                    subPivots.push({ pivot: moonPivot, speed: 0.03, axis: 'y' });

                    moonMesh.userData = {
                        name: moonData.name,
                        data: moonData
                    };

                    planetMesh.userData.moonPivot = moonPivot;
                    celestialMeshes.Moon = moonMesh;

                    // Clementine Spacecraft
                    const clementineData = CELESTIAL_DATA.Clementine;
                    const clementineMesh = createRealisticClementineMesh();
                    clementineMesh.position.set(2.2, 0, 0);
                    const clementinePivot = new THREE.Object3D();
                    moonMesh.add(clementinePivot);
                    clementinePivot.add(clementineMesh);
                    subPivots.push({ pivot: clementinePivot, speed: 0.04, axis: 'y' });
                    clementineMesh.userData = { name: clementineData.name, data: clementineData };
                    celestialMeshes.Clementine = clementineMesh;

                    // Lunar Prospector
                    const lpData = CELESTIAL_DATA.LunarProspector;
                    const lpMesh = createRealisticLunarProspectorMesh();
                    lpMesh.position.set(0, 3.1, 0);
                    const lpPivot = new THREE.Object3D();
                    moonMesh.add(lpPivot);
                    lpPivot.add(lpMesh);
                    subPivots.push({ pivot: lpPivot, speed: 0.035, axis: 'x' });
                    lpMesh.userData = { name: lpData.name, data: lpData };
                    celestialMeshes.LunarProspector = lpMesh;

                    // GRAIL
                    const grailData = CELESTIAL_DATA.GRAIL;
                    const grailMesh = createRealisticGrailTandemMesh();
                    grailMesh.position.set(0, 1.5, 0);
                    const grailPivot = new THREE.Object3D();
                    moonMesh.add(grailPivot);
                    grailPivot.add(grailMesh);
                    subPivots.push({ pivot: grailPivot, speed: 0.045, axis: 'z' });
                    grailMesh.userData = { name: grailData.name, data: grailData };
                    celestialMeshes.GRAIL = grailMesh;

                    // Explorer 35
                    const exp35Data = CELESTIAL_DATA.Explorer35;
                    const exp35Mesh = createRealisticExplorer35Mesh();
                    exp35Mesh.position.set(4.2, 0, 0);
                    const exp35Pivot = new THREE.Object3D();
                    moonMesh.add(exp35Pivot);
                    exp35Pivot.add(exp35Mesh);
                    subPivots.push({ pivot: exp35Pivot, speed: 0.025, axis: 'y' });
                    exp35Mesh.userData = { name: exp35Data.name, data: exp35Data };
                    celestialMeshes.Explorer35 = exp35Mesh;
                }

                if (key === 'Mars') {
                    const spiritModel = createSpiritRoverModel();
                    spiritModel.position.set(0, data.radius + 0.02, 0);
                    planetMesh.add(spiritModel);
                    celestialMeshes.Spirit = spiritModel;
                    spiritModel.userData = { name: 'Spirit Rover', data: CELESTIAL_DATA.Spirit };

                    const orbiterModel = createMarsClimateOrbiterModel();
                    const orbiterPivot = new THREE.Object3D();
                    orbiterModel.position.set(data.radius + 1.2, 0, 0);
                    orbiterPivot.add(orbiterModel);
                    planetMesh.add(orbiterPivot);
                    subPivots.push({ pivot: orbiterPivot, speed: 0.035, axis: 'y' });
                    celestialMeshes.Orbiter = orbiterModel;
                    orbiterModel.userData = { name: 'Mars Climate Orbiter', data: CELESTIAL_DATA.Orbiter };

                    const surveyorModel = createMarsGlobalSurveyorModel();
                    const surveyorPivot = new THREE.Object3D();
                    surveyorModel.position.set(data.radius + 1.5, 0, 0);
                    surveyorPivot.add(surveyorModel);
                    planetMesh.add(surveyorPivot);
                    subPivots.push({ pivot: surveyorPivot, speed: 0.028, axis: 'x' });
                    celestialMeshes.Surveyor = surveyorModel;
                    surveyorModel.userData = { name: 'Mars Global Surveyor', data: CELESTIAL_DATA.Surveyor };

                    const marinerModel = createMariner9Model();
                    const marinerPivot = new THREE.Object3D();
                    marinerModel.position.set(data.radius + 1.8, 0, 0);
                    marinerPivot.add(marinerModel);
                    planetMesh.add(marinerPivot);
                    subPivots.push({ pivot: marinerPivot, speed: 0.022, axis: 'z' });
                    celestialMeshes.Mariner9 = marinerModel;
                    marinerModel.userData = { name: 'Mariner 9 Orbiter', data: CELESTIAL_DATA.Mariner9 };
                }
            });
        }

        function displayPlanetInfo(data) {
            document.getElementById('info-title').textContent = data.name;
            document.getElementById('info-type').textContent = data.type;
            document.getElementById('info-description').textContent = data.description || '';
            document.getElementById('info-diameter').textContent = data.diameter || 'N/A';
            document.getElementById('info-distance').textContent = data.distFromSun || 'N/A';
            document.getElementById('info-period').textContent = data.orbitalPeriod || 'N/A';
            document.getElementById('info-moons').textContent = data.moons !== undefined ? data.moons : 'N/A';
            document.getElementById('info-fact').textContent = data.fact || '';
            document.getElementById('info-color-indicator').style.backgroundColor = data.color;

            // Toggle Storytelling & Scientific Mode Button visibility based on files
            const btnStory = document.getElementById('btn-storytelling-mode');
            const btnHeaderStory = document.getElementById('btn-header-story');
            const btnSci = document.getElementById('btn-scientific-mode');
            const btnHeaderSci = document.getElementById('btn-header-scientific');

            if (data.storyFile) {
                btnStory.classList.remove('hidden');
                btnStory.classList.add('flex');
                btnHeaderStory.classList.remove('hidden');
                btnHeaderStory.classList.add('flex');
            } else {
                btnStory.classList.add('hidden');
                btnStory.classList.remove('flex');
                btnHeaderStory.classList.add('hidden');
                btnHeaderStory.classList.remove('flex');
                closeStorytellingMode();
            }

            if (data.sciFile) {
                btnSci.classList.remove('hidden');
                btnSci.classList.add('flex');
                btnHeaderSci.classList.remove('hidden');
                btnHeaderSci.classList.add('flex');
            } else {
                btnSci.classList.add('hidden');
                btnSci.classList.remove('flex');
                btnHeaderSci.classList.add('hidden');
                btnHeaderSci.classList.remove('flex');
                closeScientificMode();
            }

            const panel = document.getElementById('info-panel');
            panel.classList.remove('translate-x-[360px]');
            panel.classList.add('translate-x-0');
        }

        function hidePlanetInfo() {
            const panel = document.getElementById('info-panel');
            panel.classList.remove('translate-x-0');
            panel.classList.add('translate-x-[360px]');
            const btnHeaderSci = document.getElementById('btn-header-scientific');
            const btnHeaderStory = document.getElementById('btn-header-story');
            btnHeaderSci.classList.add('hidden');
            btnHeaderSci.classList.remove('flex');
            btnHeaderStory.classList.add('hidden');
            btnHeaderStory.classList.remove('flex');
            closeScientificMode();
            closeStorytellingMode();
        }

        function focusOnTarget(targetName) {
            const mesh = celestialMeshes[targetName];
            if (!mesh) return;

            selectedObject = mesh;
            displayPlanetInfo(mesh.userData.data);

            const worldPos = new THREE.Vector3();
            mesh.getWorldPosition(worldPos);

            const duration = 800;
            const startTarget = controls.target.clone();
            const endTarget = worldPos;
            const startTime = performance.now();

            function animateCameraFocus(time) {
                const elapsed = time - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const ease = 0.5 - Math.cos(progress * Math.PI) / 2;
                controls.target.lerpVectors(startTarget, endTarget, ease);
                controls.update();

                if (progress < 1) {
                    requestAnimationFrame(animateCameraFocus);
                }
            }
            requestAnimationFrame(animateCameraFocus);
        }

        function resetCameraView() {
            selectedObject = null;
            hidePlanetInfo();
            document.getElementById('select-focus').value = 'Sun';

            const duration = 1000;
            const startPos = camera.position.clone();
            const startTarget = controls.target.clone();
            const startTime = performance.now();

            function animateReset(time) {
                const elapsed = time - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const ease = 0.5 - Math.cos(progress * Math.PI) / 2;
                camera.position.lerpVectors(startPos, defaultCameraPos, ease);
                controls.target.lerpVectors(startTarget, defaultTarget, ease);
                controls.update();

                if (progress < 1) {
                    requestAnimationFrame(animateReset);
                }
            }
            requestAnimationFrame(animateReset);
        }

        function onPointerDown(event) {
            if (
                event.target.closest('#info-panel') ||
                event.target.closest('button') ||
                event.target.closest('input') ||
                event.target.closest('select') ||
                event.target.closest('#scientific-modal') ||
                event.target.closest('#story-modal')
            ) {
                return;
            }

            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            
            const focusableMeshes = Object.keys(celestialMeshes)
                .filter(key => FOCUSABLE_OBJECTS.includes(key))
                .map(key => celestialMeshes[key]);

            const intersects = raycaster.intersectObjects(focusableMeshes, true);

            if (intersects.length > 0) {
                let clickedObj = intersects[0].object;
                while (clickedObj && !clickedObj.userData.name && clickedObj.parent) {
                    clickedObj = clickedObj.parent;
                }
                if (clickedObj && clickedObj.userData.name) {
                    const name = clickedObj.userData.name;
                    let selectKey = name;
                    if (name === 'Spirit Rover') selectKey = 'Spirit';
                    if (name === 'Mars Climate Orbiter') selectKey = 'Orbiter';
                    if (name === 'Mars Global Surveyor') selectKey = 'Surveyor';
                    if (name === 'Mariner 9 Orbiter') selectKey = 'Mariner9';
                    if (name.includes('GRAIL')) selectKey = 'GRAIL';
                    if (name.includes('Explorer')) selectKey = 'Explorer35';
                    if (name === 'Lunar Prospector') selectKey = 'LunarProspector';
                    
                    document.getElementById('select-focus').value = selectKey;
                    focusOnTarget(selectKey);
                }
            }
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        document.getElementById('btn-pause').addEventListener('click', () => {
            isPaused = !isPaused;
            const icon = document.getElementById('icon-pause');
            const label = document.getElementById('label-pause');
            if (isPaused) {
                icon.className = 'fa-solid fa-play';
                label.textContent = 'Resume';
            } else {
                icon.className = 'fa-solid fa-pause';
                label.textContent = 'Pause';
            }
        });

        document.getElementById('slider-speed').addEventListener('input', (e) => {
            simSpeed = parseFloat(e.target.value);
            document.getElementById('value-speed').textContent = simSpeed.toFixed(1) + 'x';
        });

        document.getElementById('btn-toggle-orbits').addEventListener('click', (e) => {
            const isVisible = orbitLines[0] ? orbitLines[0].visible : true;
            orbitLines.forEach(line => line.visible = !isVisible);
            e.currentTarget.classList.toggle('opacity-50', isVisible);
        });

        document.getElementById('btn-reset-view').addEventListener('click', () => {
            resetCameraView();
        });

        document.getElementById('select-focus').addEventListener('change', (e) => {
            if (e.target.value === 'Sun') {
                resetCameraView();
            } else {
                focusOnTarget(e.target.value);
            }
        });

        document.getElementById('btn-close-info').addEventListener('click', () => {
            hidePlanetInfo();
        });

        function animate() {
            requestAnimationFrame(animate);

            if (!isPaused) {
                if (celestialMeshes.Sun) {
                    celestialMeshes.Sun.rotation.y += CELESTIAL_DATA.Sun.rotationSpeed * simSpeed;
                }

                Object.keys(celestialMeshes).forEach((key) => {
                    if (key === 'Sun' || key === 'Moon' || key === 'Clementine' || key === 'LunarProspector' || key === 'GRAIL' || key === 'Explorer35' || key === 'Spirit' || key === 'Orbiter' || key === 'Surveyor' || key === 'Mariner9') return;
                    const planet = celestialMeshes[key];
                    const data = planet.userData.data;

                    planet.userData.angle += data.speed * 0.5 * simSpeed;
                    planet.position.x = Math.cos(planet.userData.angle) * data.distance;
                    planet.position.z = Math.sin(planet.userData.angle) * data.distance;

                    planet.rotation.y += data.rotationSpeed * simSpeed;
                });

                subPivots.forEach((item) => {
                    item.pivot.rotation[item.axis] += item.speed * 0.5 * simSpeed;
                });
            }

            if (selectedObject && selectedObject.userData.name !== 'Sun') {
                const targetWorldPos = new THREE.Vector3();
                selectedObject.getWorldPosition(targetWorldPos);
                controls.target.copy(targetWorldPos);
            }

            controls.update();
            renderer.render(scene, camera);
        }

        window.onload = function() {
            initScene();
            animate();
        };
    </script>
</body>
