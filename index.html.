<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Solar System Explorer - Scientific & Storytelling Mode</title>
    <!-- Tailwind CSS for UI Overlay -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
   
    <!-- Three.js and OrbitControls -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: #030712;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            user-select: none;
        }
        #canvas-container {
            width: 100vw;
            height: 100vh;
            display: block;
            position: relative;
            z-index: 1;
        }
        .glass-panel {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        ::-webkit-scrollbar {
            width: 5px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.4);
        }
    </style>
</head>
<body class="text-slate-100 overflow-hidden">
    <!-- 3D Canvas Container -->
    <div id="canvas-container"></div>
    
    <!-- Header Overlay with Scientific & Storytelling Mode Toggles -->
    <header class="absolute top-4 left-4 right-4 flex justify-between items-center pointer-events-none z-20">
        <div class="glass-panel px-4 py-2.5 rounded-2xl flex items-center gap-3 pointer-events-auto border border-amber-500/20 shadow-xl shadow-amber-500/5">
            <i class="fa-solid fa-sun text-amber-400 text-2xl animate-spin" style="animation-duration: 15s;"></i>
            <div>
                <h1 class="font-bold text-base md:text-lg leading-tight bg-gradient-to-r from-amber-300 via-orange-300 to-yellow-100 bg-clip-text text-transparent">3D Solar System Explorer</h1>
                <p class="text-[11px] text-slate-400">Full Solar System (Focus: Sun, Earth, Moon, Spacecraft & Mars Missions)</p>
            </div>
        </div>

        <div class="pointer-events-auto flex items-center gap-3">
            <!-- Header Storytelling Mode Toggle Button -->
            <button id="btn-header-story" onclick="toggleStorytellingModeHeader(event)" class="hidden px-3.5 py-2 rounded-xl text-xs font-mono font-bold transition-all text-orange-400 bg-orange-500/10 border border-orange-500/30 hover:bg-orange-500/20 shadow-lg shadow-orange-500/10 items-center gap-2 cursor-pointer">
                <i class="fa-solid fa-book-open text-orange-400"></i>
                <span>Storytelling Mode: <span id="story-mode-header-status" class="text-slate-200">OFF</span></span>
            </button>

            <!-- Header Scientific Mode Toggle Button -->
            <button id="btn-header-scientific" onclick="toggleScientificModeHeader(event)" class="hidden px-3.5 py-2 rounded-xl text-xs font-mono font-bold transition-all text-amber-400 bg-amber-500/10 border border-amber-500/30 hover:bg-amber-500/20 shadow-lg shadow-amber-500/10 items-center gap-2 cursor-pointer">
                <i class="fa-solid fa-atom text-amber-400 animate-spin" style="animation-duration: 6s;"></i>
                <span>Scientific Mode: <span id="sci-mode-header-status" class="text-slate-200">OFF</span></span>
            </button>

            <div class="glass-panel px-4 py-2 rounded-xl text-xs text-slate-300 hidden lg:flex items-center gap-4 border border-slate-700/50">
                <span><i class="fa-solid fa-mouse-pointer text-amber-400 mr-1"></i> Left Click + Drag: Rotate</span>
                <span><i class="fa-solid fa-up-down-left-right text-amber-400 mr-1"></i> Right Click + Drag: Pan</span>
                <span><i class="fa-solid fa-magnifying-glass-plus text-amber-400 mr-1"></i> Scroll: Zoom</span>
            </div>
        </div>
    </header>

    <!-- Main Control Panel (Bottom) -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 w-11/12 max-w-xl">
        <div class="glass-panel p-3 md:p-4 rounded-2xl shadow-2xl flex flex-wrap items-center justify-between gap-3 border border-slate-700/60">
            <!-- Play/Pause Button -->
            <button id="btn-pause" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-3.5 py-2 rounded-xl transition duration-200 flex items-center gap-2 shadow-md shadow-amber-500/20 text-xs md:text-sm cursor-pointer">
                <i id="icon-pause" class="fa-solid fa-pause"></i>
                <span id="label-pause">Pause</span>
            </button>
            
            <!-- Orbit Speed Slider -->
            <div class="flex items-center gap-2 md:gap-3 flex-1 min-w-[140px]">
                <i class="fa-solid fa-gauge-high text-amber-400 text-xs md:text-sm"></i>
                <span class="text-xs font-semibold text-slate-300 min-w-[38px]">Speed:</span>
                <input type="range" id="slider-speed" min="0" max="5" step="0.1" value="1"
                    class="w-full accent-amber-400 bg-slate-800 rounded-lg h-1.5 cursor-pointer">
                <span id="value-speed" class="text-xs text-amber-300 font-mono w-8">1.0x</span>
            </div>

            <!-- Orbit Lines Toggle -->
            <button id="btn-toggle-orbits" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-2 rounded-xl border border-slate-600 transition flex items-center gap-2 cursor-pointer">
                <i class="fa-solid fa-circle-notch text-amber-400"></i>
                <span class="hidden sm:inline">Orbits</span>
            </button>

            <!-- Reset View Button -->
            <button id="btn-reset-view" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-2 rounded-xl border border-slate-600 transition flex items-center gap-2 cursor-pointer" title="Reset View">
                <i class="fa-solid fa-rotate-right text-amber-400"></i>
                <span class="hidden sm:inline">Reset</span>
            </button>

            <!-- Target Selection Dropdown -->
            <select id="select-focus" class="bg-slate-800 border border-slate-700 text-slate-200 text-xs rounded-xl px-2.5 py-2 outline-none focus:border-amber-400 cursor-pointer">
                <option value="Sun">Focus: Sun</option>
                <option value="Earth">Earth</option>
                <option value="Moon">Earth's Moon</option>
                <option value="Clementine">Clementine Spacecraft</option>
                <option value="LunarProspector">Lunar Prospector (NASA)</option>
                <option value="GRAIL">GRAIL (Ebb & Flow - NASA)</option>
                <option value="Explorer35">Explorer 35 (AIMP-E - NASA)</option>
                <option value="Mars">Mars</option>
                <option value="Spirit">Spirit Rover (Mars)</option>
                <option value="Orbiter">Mars Climate Orbiter</option>
                <option value="Surveyor">Mars Global Surveyor</option>
                <option value="Mariner9">Mariner 9 Orbiter</option>
            </select>
        </div>
    </div>

    <!-- Information Sidebar Panel -->
    <aside id="info-panel" class="absolute top-20 right-4 z-20 w-80 glass-panel rounded-2xl p-5 shadow-2xl transition-all duration-300 translate-x-[360px] max-h-[calc(100vh-120px)] overflow-y-auto border border-slate-700/60">
        <div class="flex justify-between items-center border-b border-slate-700/60 pb-3 mb-4">
            <div class="flex items-center gap-2.5">
                <span id="info-color-indicator" class="w-3.5 h-3.5 rounded-full bg-amber-400 inline-block shadow-sm"></span>
                <div>
                    <h2 id="info-title" class="text-xl font-bold bg-gradient-to-r from-white to-slate-300 bg-clip-text text-transparent leading-tight">Sun</h2>
                    <span id="info-type" class="text-[10px] uppercase tracking-wider font-bold text-amber-400">Star</span>
                </div>
            </div>
            <button id="btn-close-info" class="text-slate-400 hover:text-white transition p-1 cursor-pointer">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>
        
        <p id="info-description" class="text-xs text-slate-300 leading-relaxed mb-4">
            The star at the center of our Solar System. It holds 99.8% of the Solar System's total mass.
        </p>

        <!-- Scientific Mode Button (Visible inside Sidebar for Satellites) -->
        <button id="btn-scientific-mode" onclick="openScientificMode(event)" class="w-full hidden mb-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold py-2.5 px-4 rounded-xl text-xs items-center justify-center gap-2 shadow-lg shadow-cyan-500/20 transition-all cursor-pointer">
            <i class="fa-solid fa-microscope"></i>
            <span>View Scientific Mode</span>
        </button>

        <!-- Storytelling Mode Button (Visible inside Sidebar for Satellites) -->
        <button id="btn-storytelling-mode" onclick="openStorytellingMode(event)" class="w-full hidden mb-4 bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-400 hover:to-amber-500 text-slate-950 font-bold py-2.5 px-4 rounded-xl text-xs items-center justify-center gap-2 shadow-lg shadow-orange-500/20 transition-all cursor-pointer">
            <i class="fa-solid fa-book-open"></i>
            <span>View Storytelling Mode</span>
        </button>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-2 text-xs mb-4">
            <div class="bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                <span class="text-slate-400 block text-[10px] uppercase font-semibold">Diameter / Size</span>
                <span id="info-diameter" class="font-bold text-amber-300">1,392,700 km</span>
            </div>
            <div class="bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                <span class="text-slate-400 block text-[10px] uppercase font-semibold">Dist. from Sun</span>
                <span id="info-distance" class="font-bold text-amber-300">0 AU</span>
            </div>
            <div class="bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                <span class="text-slate-400 block text-[10px] uppercase font-semibold">Orbital Period</span>
                <span id="info-period" class="font-bold text-amber-300">N/A</span>
            </div>
            <div class="bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                <span class="text-slate-400 block text-[10px] uppercase font-semibold">Moons / Payload</span>
                <span id="info-moons" class="font-bold text-amber-300">0</span>
            </div>
        </div>

        <!-- Fun Fact Box -->
        <div class="bg-amber-500/10 border border-amber-500/20 p-3 rounded-xl">
            <div class="flex items-center gap-1.5 text-amber-400 font-semibold text-xs mb-1">
                <i class="fa-solid fa-lightbulb"></i> Quick Fact / Highlight
            </div>
            <p id="info-fact" class="text-xs text-slate-300 italic">
                Over one million Earths could fit inside the Sun!
            </p>
        </div>
    </aside>

    <!-- FULLSCREEN SCIENTIFIC MODE OVERLAY IFRAME -->
    <div id="scientific-modal" class="fixed inset-0 z-50 bg-slate-950/95 hidden flex-col">
        <div class="flex justify-between items-center p-3 bg-slate-900 border-b border-slate-800 shrink-0">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-microscope text-cyan-400 text-lg"></i>
                <h3 id="sci-modal-title" class="font-bold text-cyan-400 font-mono text-sm uppercase">Scientific Dashboard Mode</h3>
            </div>
            <button onclick="closeScientificMode(event)" class="px-3.5 py-1.5 bg-red-600 hover:bg-red-500 text-white font-bold text-xs rounded-lg transition cursor-pointer">
                <i class="fa-solid fa-xmark mr-1"></i> Exit Scientific Mode
            </button>
        </div>
        <iframe id="sci-iframe" class="w-full flex-1 border-none bg-slate-950" src=""></iframe>
    </div>

    <!-- FULLSCREEN STORYTELLING MODE OVERLAY IFRAME -->
    <div id="story-modal" class="fixed inset-0 z-50 bg-slate-950/95 hidden flex-col">
        <div class="flex justify-between items-center p-3 bg-slate-900 border-b border-slate-800 shrink-0">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-book-open text-orange-400 text-lg"></i>
                <h3 id="story-modal-title" class="font-bold text-orange-400 font-mono text-sm uppercase">Storytelling Documentary Mode</h3>
            </div>
            <button onclick="closeStorytellingMode(event)" class="px-3.5 py-1.5 bg-red-600 hover:bg-red-500 text-white font-bold text-xs rounded-lg transition cursor-pointer">
                <i class="fa-solid fa-xmark mr-1"></i> Exit Storytelling Mode
            </button>
        </div>
        <iframe id="story-iframe" class="w-full flex-1 border-none bg-slate-950" src=""></iframe>
    </div>

