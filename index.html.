        function createProceduralTexture(type, baseHex, detailHex) {
            const canvas = document.createElement('canvas');
            canvas.width = 512;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = baseHex;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            for (let i = 0; i < 1000; i++) {
                const x = Math.random() * canvas.width;
                const y = Math.random() * canvas.height;
                const r = Math.random() * (type === 'gas' ? 16 : 5);
                ctx.fillStyle = detailHex;
                ctx.globalAlpha = Math.random() * 0.25;
                ctx.beginPath();
                ctx.arc(x, y, r, 0, Math.PI * 2);
                ctx.fill();
            }

            if (type === 'gas') {
                for (let y = 0; y < canvas.height; y += 6) {
                    if (Math.random() > 0.35) {
                        ctx.fillStyle = detailHex;
                        ctx.globalAlpha = Math.random() * 0.3;
                        ctx.fillRect(0, y, canvas.width, Math.random() * 10);
                    }
                }
            }

            const texture = new THREE.CanvasTexture(canvas);
            texture.wrapS = THREE.RepeatWrapping;
            texture.wrapT = THREE.ClampToEdgeWrapping;
            return texture;
        }

        function createSolarPanelTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#071e3d';
            ctx.fillRect(0, 0, 256, 256);

            // Subtle blue photovoltaic cell gradient
            const grad = ctx.createLinearGradient(0, 0, 256, 256);
            grad.addColorStop(0, '#0a2e5c');
            grad.addColorStop(0.5, '#134e96');
            grad.addColorStop(1, '#09264d');
            ctx.fillStyle = grad;
            ctx.fillRect(4, 4, 248, 248);

            // Silver grid lines for solar cells
            ctx.strokeStyle = '#60a5fa';
            ctx.lineWidth = 1.5;
            for (let x = 0; x <= 256; x += 32) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, 256);
                ctx.stroke();
            }
            for (let y = 0; y <= 256; y += 16) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(256, y);
                ctx.stroke();
            }

            // Busbars
            ctx.strokeStyle = '#e2e8f0';
            ctx.lineWidth = 1;
            for (let x = 16; x < 256; x += 32) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, 256);
                ctx.stroke();
            }

            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            return tex;
        }

        function createFoilBumpTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 128;
            canvas.height = 128;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#808080';
            ctx.fillRect(0, 0, 128, 128);
            for (let i = 0; i < 400; i++) {
                ctx.strokeStyle = Math.random() > 0.5 ? '#ffffff' : '#222222';
                ctx.lineWidth = 1;
                ctx.globalAlpha = 0.25;
                ctx.beginPath();
                const x = Math.random() * 128;
                const y = Math.random() * 128;
                ctx.moveTo(x, y);
                ctx.lineTo(x + (Math.random() - 0.5) * 18, y + (Math.random() - 0.5) * 18);
                ctx.stroke();
            }
            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            return tex;
        }

        function createStarfield() {
            const count = 5000;
            const geometry = new THREE.BufferGeometry();
            const positions = new Float32Array(count * 3);
            const colors = new Float32Array(count * 3);

            for (let i = 0; i < count * 3; i += 3) {
                positions[i] = (Math.random() - 0.5) * 1600;
                positions[i + 1] = (Math.random() - 0.5) * 1600;
                positions[i + 2] = (Math.random() - 0.5) * 1600;

                const col = new THREE.Color().setHSL(Math.random() * 0.2 + 0.5, 0.4, Math.random() * 0.6 + 0.4);
                colors[i] = col.r;
                colors[i + 1] = col.g;
                colors[i + 2] = col.b;
            }

            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

            const material = new THREE.PointsMaterial({
                size: 1.2,
                vertexColors: true,
                transparent: true,
                opacity: 0.85
            });

            const starfield = new THREE.Points(geometry, material);
            scene.add(starfield);
        }

        function createOrbitRing(distance) {
            const points = [];
            const segments = 128;
            for (let i = 0; i <= segments; i++) {
                const theta = (i / segments) * Math.PI * 2;
                points.push(new THREE.Vector3(Math.cos(theta) * distance, 0, Math.sin(theta) * distance));
            }
            const geometry = new THREE.BufferGeometry().setFromPoints(points);
            const material = new THREE.LineBasicMaterial({
                color: 0x334155,
                transparent: true,
                opacity: 0.45
            });
            const ring = new THREE.Line(geometry, material);
            scene.add(ring);
            orbitLines.push(ring);
        }

